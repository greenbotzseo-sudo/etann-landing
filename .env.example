# Copy to .env and fill in.
VITE_SPLUS_FORM_URL=https://report.splus.one/v1/Training/LeadCourseForm?enckey=YOUR_KEY

# Tracking (optional). Use EITHER a GTM container OR the direct tags.
VITE_GTM_ID=
VITE_GADS_ID=
VITE_GADS_LEAD_LABEL=
VITE_GADS_WHATSAPP_LABEL=
VITE_META_PIXEL_ID=

# Live Google reviews (optional). Maps JavaScript API key, restricted to this site's domain (HTTP referrer)
# and to the "Maps JavaScript API" + "Places API (New)". Place ID = ETANN's Google Business listing.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_PLACE_ID=ChIJO2HaHuAZ2jERIha01SQTxIg

# Google-reviews widget (optional), shown when the API above returns no review text.
# Trustindex: https://cdn.trustindex.io/loader.js?XXXXXXXX   Elfsight: elfsight:XXXXXXXX-XXXX-...
VITE_REVIEWS_WIDGET=
